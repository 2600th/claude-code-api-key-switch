# Normalize line endings in the repo
* text=auto

# Bash scripts must keep LF, or Git Bash, macOS and Linux fail with "$'\r': command not found"
*.sh           text eol=lf
claude-api     text eol=lf
claude-api-run text eol=lf
claude-api-check text eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
