# 1. Copy this file and name the copy .env.claude (same folder).
# 2. Paste your key below.
# .env.claude is private. Git ignores it. Never share or commit it.
#
# Using your Max/Team monthly API credits? Create this key in the Console
# organization linked to your plan (claude.ai > Settings > Billing > API credits).

ANTHROPIC_API_KEY=sk-ant-...

# Only for keys that start with sk-ant-usr. Delete this line otherwise.
# Find it at platform.claude.com > Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=wrkspc_...
